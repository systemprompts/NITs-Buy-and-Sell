# Local development. Copy real values from .env.example for production (Vercel).

# Bypass Google OAuth locally (signs in a mock @nits.ac.in student).
MOCK_AUTH=True

SECRET_KEY=local-dev-secret

# No DATABASE_URL  -> local SQLite (app.db)
# No SUPABASE_*    -> images saved to app/static/uploads/

# SITE_URL is only used for canonical/OG/sitemap links.
SITE_URL=http://localhost:5000

# Real Google OAuth (only needed when MOCK_AUTH is not true):
# GOOGLE_CLIENT_ID=your_client_id_here
# GOOGLE_CLIENT_SECRET=your_client_secret_here
